# Local development values for docker-compose.yml. Copy to .env (git-ignored) and adjust.
# Never put real secrets here - this file is committed. Keep it in sync with every variable the services read.

# Host ports
BACKEND_PORT=3000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# Postgres (local only)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@postgres:5432/app

# Redis
REDIS_URL=redis://redis:6379

# Backend
NODE_ENV=development

# Frontend (values exposed to the browser - public only)
VITE_API_URL=http://localhost:3000

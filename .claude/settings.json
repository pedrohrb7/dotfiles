{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(which *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(rtk ls *)",
      "Bash(rtk tree *)",
      "Bash(rtk read *)",
      "Bash(rtk grep *)",
      "Bash(rtk wc *)",
      "Bash(rtk git status *)",
      "Bash(rtk git log *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git show *)"
    ],
    "defaultMode": "auto"
  },
  "timeFormat": "24-hour",
  "theme": "dark",
  "useAutoModeDuringPlan": false,
  "skillOverrides": {
    "archify": "off",
    "codebase-standards": "off",
    "dep-audit": "off",
    "design-system": "off",
    "docs": "off",
    "grill-me": "off",
    "pr-description": "off",
    "review": "off",
    "scaffold": "off",
    "tdd": "off",
    "code-simplify": "off"
  }
}
